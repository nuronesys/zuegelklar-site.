{
  "name": "zuegelklar-site",
  "private": true,
  "version": "0.9.5",
  "description": "Statische Website von ZÜGELKLAR (GitHub Pages). Gemeinsame Bausteine via tools/build.mjs, keine Abhängigkeiten.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "serve": "node tools/serve.mjs",
    "check:quality": "node scripts/quality-gate.mjs",
    "check:site": "node scripts/prelaunch-check.mjs && node scripts/quality-gate.mjs",
    "check:launch": "node scripts/prelaunch-check.mjs --launch && node scripts/quality-gate.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
